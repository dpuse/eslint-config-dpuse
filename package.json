{
    "name": "@dpuse/eslint-config-dpuse",
    "version": "1.0.117",
    "private": false,
    "description": "Common ESLint configuration used in most DPUse projects.",
    "license": "MIT",
    "author": "Jonathan Terrell <terrell.jm@gmail.com>",
    "type": "module",
    "homepage": "https://www.dpuse.app",
    "bugs": {
        "url": "https://github.com/dpuse/eslint-config-dpuse/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dpuse/eslint-config-dpuse.git"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=24",
        "npm": ">=12"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=12",
            "onFail": "error"
        }
    },
    "prettier": "@dpuse/dpuse-development/prettierrc",
    "allowScripts": {
        "unrs-resolver@1.11.1": true
    },
    "scripts": {
        "audit": "node -e \"import('@dpuse/dpuse-development').then(m => m.auditDependencies())\"",
        "build": "tsc -p tsconfig.build.json",
        "check": "node -e \"import('@dpuse/dpuse-development').then(m => m.checkConfigFiles())\" && node -e \"import('@dpuse/dpuse-development').then(m => m.checkDependencies())\"",
        "document": "npm run documentOpening && npm run documentUsage && npm run documentDependencies && npm run documentGovernance",
        "documentDependencies": "node -e \"import('@dpuse/dpuse-development').then(m => m.documentDependencies(''))\"",
        "documentGovernance": "node -e \"import('@dpuse/dpuse-development').then(m => m.documentGovernance())\"",
        "documentOpening": "node -e \"import('@dpuse/dpuse-development').then(m => m.documentOpening())\"",
        "documentUsage": "node -e \"import('@dpuse/dpuse-development').then(m => m.documentUsage())\"",
        "format": "node -e \"import('@dpuse/dpuse-development').then(m => m.formatCode())\"",
        "lint": "node -e \"import('@dpuse/dpuse-development').then(m => m.lintCode())\"",
        "release": "npm run sync && gh release create \"v$(npm pkg get version | tr -d '\"')\" --target \"$(git rev-parse HEAD)\" --generate-notes --latest",
        "sync": "node -e \"import('@dpuse/dpuse-development').then(m => m.syncProjectWithGitHub())\"",
        "test:e2e": "echo \"❌ 'test:e2e' command not implemented.\"",
        "test:unit": "echo \"❌ 'test:unit' command not implemented.\""
    },
    "peerDependencies": {
        "eslint": "^10.11.0"
    },
    "dependencies": {
        "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-n": "^18.3.0",
        "eslint-plugin-regexp": "^3.3.1",
        "eslint-plugin-security": "^4.0.1",
        "eslint-plugin-sonarjs": "^4.2.1",
        "eslint-plugin-unicorn": "^76.0.0",
        "typescript-eslint": "^8.70.1"
    },
    "devDependencies": {
        "@dpuse/dpuse-development": "^0.3.715",
        "@types/eslint-plugin-security": "^3.0.1",
        "@types/node": "^26.6.2",
        "eslint": "^10.11.0",
        "prettier": "^3.9.8",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.1"
    }
}