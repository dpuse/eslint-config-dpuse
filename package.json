{
    "name": "@dpuse/eslint-config-dpuse",
    "version": "1.0.142",
    "private": false,
    "description": "Common ESLint configuration used across DPUse projects.",
    "license": "MIT",
    "author": "Jonathan Terrell <terrell.jm@gmail.com>",
    "type": "module",
    "homepage": "https://www.dpuse.app",
    "bugs": {
        "url": "https://github.com/dpuse/eslint-config-dpuse/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dpuse/eslint-config-dpuse.git"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=24",
        "npm": ">=12"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=12",
            "onFail": "error"
        }
    },
    "prettier": "@dpuse/dpuse-development/prettierrc",
    "allowScripts": {
        "unrs-resolver@1.11.1": true,
        "fsevents@2.3.3": true
    },
    "scripts": {
        "audit": "node -e \"import('@dpuse/dpuse-development').then(m => m.auditDependencies())\"",
        "build": "tsc -p tsconfig.build.json",
        "check": "node -e \"import('@dpuse/dpuse-development').then(m => m.checkProject())\"",
        "document": "node -e \"import('@dpuse/dpuse-development').then(m => m.documentProject(''))\"",
        "format": "node -e \"import('@dpuse/dpuse-development').then(m => m.formatCode())\"",
        "lint": "node -e \"import('@dpuse/dpuse-development').then(m => m.lintCode())\"",
        "release": "npm run build && npm run document && npm run sync && node -e \"import('@dpuse/dpuse-development').then(m => m.triggerGitHubRelease())\"",
        "sync": "node -e \"import('@dpuse/dpuse-development').then(m => m.syncProjectWithGitHub())\"",
        "test": "node -e \"import('@dpuse/dpuse-development').then(m => m.testProject())\""
    },
    "peerDependencies": {
        "eslint": "^10.13.0"
    },
    "dependencies": {
        "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
        "@eslint/js": "^10.0.1",
        "@eslint/markdown": "^8.0.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-jsdoc": "^65.4.0",
        "eslint-plugin-n": "^18.5.0",
        "eslint-plugin-regexp": "^3.3.1",
        "eslint-plugin-security": "^4.2.0",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-unicorn": "^78.0.0",
        "globals": "^17.13.0",
        "typescript-eslint": "^8.72.0"
    },
    "devDependencies": {
        "@dpuse/dpuse-development": "^1.0.130",
        "@types/eslint-plugin-security": "^3.0.1",
        "@types/node": "^26.6.5",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.13.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vitest": "^5.0.5"
    }
}
